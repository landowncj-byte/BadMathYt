[
 {
  "text": "Fifty percent profit. In forty-five days.",
  "start": 0.0,
  "end": 2.749
 },
 {
  "text": "Boston, nineteen twenty.",
  "start": 3.249,
  "end": 4.765
 },
 {
  "text": "Banks paid five percent a year.",
  "start": 4.965,
  "end": 6.693
 },
 {
  "text": "Charles Ponzi said he bought postal coupons cheap in Europe, and cashed them in America.",
  "start": 6.993,
  "end": 12.08
 },
 {
  "text": "Thousands lined up.",
  "start": 12.38,
  "end": 13.534
 },
 {
  "text": "Even most of Boston's police force bought in.",
  "start": 13.684,
  "end": 16.208
 },
 {
  "text": "But do the math.",
  "start": 16.608,
  "end": 17.565
 },
 {
  "text": "To pay everyone, he'd need a hundred and sixty million coupons.",
  "start": 17.815,
  "end": 21.563
 },
 {
  "text": "There were about twenty-seven thousand.",
  "start": 22.013,
  "end": 23.973
 },
 {
  "text": "So the profits came from the next investor.",
  "start": 24.473,
  "end": 26.733
 },
 {
  "text": "Then a newspaper checked the numbers.",
  "start": 27.083,
  "end": 28.941
 },
 {
  "text": "The line turned into a run.",
  "start": 29.191,
  "end": 30.635
 },
 {
  "text": "Six banks went down.",
  "start": 30.835,
  "end": 32.168
 },
 {
  "text": "Twenty million dollars.",
  "start": 32.368,
  "end": 33.681
 },
 {
  "text": "Gone.",
  "start": 33.831,
  "end": 34.357
 },
 {
  "text": "His name became the word for it.",
  "start": 34.807,
  "end": 36.5
 },
 {
  "text": "He died broke.",
  "start": 36.85,
  "end": 37.915
 },
 {
  "text": "Total estate: seventy-five dollars.",
  "start": 38.215,
  "end": 40.531
 }
]